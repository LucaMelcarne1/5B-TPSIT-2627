<?xml version="1.0" encoding="UTF-8"?>
<!-- DTD INTERNA: le regole sono dentro il DOCTYPE, tra parentesi quadre [ ] -->
<!DOCTYPE syslog [
  <!ELEMENT syslog (entry+)>
  <!ELEMENT entry (timestamp, source, message)>
  <!ATTLIST entry level (INFO|WARN|ERROR) #REQUIRED>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT source    (#PCDATA)>
  <!ELEMENT message   (#PCDATA)>
]>
<syslog>
  <entry level="INFO">
    <timestamp>2026-10-17T09:52:00</timestamp>
    <source>auth-service</source>
    <message>Login riuscito per l'utente DragonSlayer</message>
  </entry>
  <entry level="WARN">
    <timestamp>2026-10-17T09:53:12</timestamp>
    <source>matchmaking</source>
    <message>Latenza elevata sul nodo EU-2 (310 ms)</message>
  </entry>
  <entry level="ERROR">
    <timestamp>2026-10-17T09:54:40</timestamp>
    <source>database</source>
    <message>Connessione al DB scaduta (timeout 30s)</message>
  </entry>
</syslog>
