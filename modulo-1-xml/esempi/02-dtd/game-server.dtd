<!-- ============================================================
     game-server.dtd  -  Regole del file di configurazione ArenaCraft
     ============================================================ -->

<!-- Entità riutilizzabile: &studio; verrà sostituita dal testo -->
<!ENTITY studio "ArenaCraft Studios">

<!-- Radice: l'ordine dei figli è FISSO (sequenza con la virgola) -->
<!ELEMENT gameServer (motd?, network, gameMode, plugins?, players, bans?)>
<!ATTLIST gameServer
    name    CDATA          #REQUIRED
    version CDATA          #IMPLIED
    region  (EU|US|ASIA)   "EU">

<!ELEMENT motd (#PCDATA)>

<!ELEMENT network (ip, port, maxPlayers)>
<!ELEMENT ip         (#PCDATA)>
<!ELEMENT port       (#PCDATA)>
<!ELEMENT maxPlayers (#PCDATA)>

<!-- LIMITE DEL DTD: gameMode è solo testo, non si può
     imporre "survival|creative|adventure" su un elemento! -->
<!ELEMENT gameMode (#PCDATA)>

<!ELEMENT plugins (plugin*)>
<!ELEMENT plugin (#PCDATA)>
<!ATTLIST plugin enabled (true|false) "true">

<!ELEMENT players (player+)>
<!ELEMENT player (nickname, level)>
<!ATTLIST player
    id   ID                     #REQUIRED
    role (admin|moderator|user) "user">
<!ELEMENT nickname (#PCDATA)>
<!ELEMENT level    (#PCDATA)>

<!-- ban: due riferimenti (IDREF) a player già dichiarati -->
<!ELEMENT bans (ban*)>
<!ELEMENT ban (reason)>
<!ATTLIST ban
    player IDREF #REQUIRED
    by     IDREF #REQUIRED>
<!ELEMENT reason (#PCDATA)>
