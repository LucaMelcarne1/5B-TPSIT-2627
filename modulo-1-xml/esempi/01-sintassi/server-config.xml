<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurazione del Game Server ArenaCraft - esempio di XML well-formed -->
<gameServer name="ArenaCraft EU-1" region="EU" version="2.4.1">

  <!-- &amp; è un'entità predefinita, &#9876; è un riferimento numerico (⚔) -->
  <motd>Benvenuto su ArenaCraft &amp; Friends! Fair play sempre &#9876;</motd>

  <network>
    <ip>192.168.1.10</ip>
    <port>25565</port>
    <maxPlayers>100</maxPlayers>
  </network>

  <gameMode>survival</gameMode>

  <plugins>
    <plugin enabled="true">AntiCheat</plugin>
    <plugin enabled="true">EconomyPlus</plugin>
    <plugin enabled="false">DebugTools</plugin>
  </plugins>

  <!-- Dentro CDATA i caratteri < > & sono ammessi senza escape -->
  <startupScript><![CDATA[
    if (players < 10 && mode == "event") {
      announce("Evento <speciale> in arrivo!");
    }
  ]]></startupScript>

  <players>
    <player id="P001" role="admin">
      <nickname>DragonSlayer</nickname>
      <level>87</level>
    </player>
    <player id="P002" role="moderator">
      <nickname>PixelQueen</nickname>
      <level>64</level>
    </player>
    <player id="P003">
      <nickname>NoobMaster69</nickname>
      <level>3</level>
    </player>
  </players>

</gameServer>
