<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     game-server.xsd  -  Stesso modello del DTD, ma con TIPI DI DATO
     ============================================================ -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:gs="https://tpsit.example.org/gameserver"
           targetNamespace="https://tpsit.example.org/gameserver"
           elementFormDefault="qualified">

  <!-- ======================= TIPI SEMPLICI ======================= -->

  <!-- Porta: intero tra 1024 e 65535 (facet minInclusive/maxInclusive) -->
  <xs:simpleType name="PortType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1024"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Indirizzo IPv4: restrizione con espressione regolare (facet pattern) -->
  <xs:simpleType name="IPv4Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Numero massimo di giocatori: da 1 a 500 -->
  <xs:simpleType name="MaxPlayersType">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="500"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Enumerazioni: finalmente possibili anche su ELEMENTI di testo -->
  <xs:simpleType name="GameModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="survival"/>
      <xs:enumeration value="creative"/>
      <xs:enumeration value="adventure"/>
      <xs:enumeration value="spectator"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RegionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EU"/>
      <xs:enumeration value="US"/>
      <xs:enumeration value="ASIA"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RoleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="admin"/>
      <xs:enumeration value="moderator"/>
      <xs:enumeration value="user"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Versione semantica: 2.4.1 -->
  <xs:simpleType name="VersionType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Identificatore giocatore: P001, P002, ... -->
  <xs:simpleType name="PlayerIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="P[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Nickname: 3-16 caratteri tra lettere, numeri e underscore -->
  <xs:simpleType name="NicknameType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_]+"/>
      <xs:minLength value="3"/>
      <xs:maxLength value="16"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Livello: 1..100 -->
  <xs:simpleType name="LevelType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ======================= TIPI COMPLESSI ======================= -->

  <xs:complexType name="NetworkType">
    <xs:sequence>
      <xs:element name="ip"         type="gs:IPv4Type"/>
      <xs:element name="port"       type="gs:PortType"/>
      <xs:element name="maxPlayers" type="gs:MaxPlayersType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Testo + attributo: si usa simpleContent con extension -->
  <xs:complexType name="PluginType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="PluginsType">
    <xs:sequence>
      <xs:element name="plugin" type="gs:PluginType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PlayerType">
    <xs:sequence>
      <xs:element name="nickname" type="gs:NicknameType"/>
      <xs:element name="level"    type="gs:LevelType"/>
      <!-- xs:date: formato AAAA-MM-GG. Opzionale (minOccurs="0") -->
      <xs:element name="joined"   type="xs:date" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id"   type="gs:PlayerIdType" use="required"/>
    <xs:attribute name="role" type="gs:RoleType"     default="user"/>
  </xs:complexType>

  <xs:complexType name="PlayersType">
    <xs:sequence>
      <xs:element name="player" type="gs:PlayerType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BanType">
    <xs:sequence>
      <xs:element name="reason" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="player" type="gs:PlayerIdType" use="required"/>
    <xs:attribute name="by"     type="gs:PlayerIdType" use="required"/>
    <xs:attribute name="date"   type="xs:dateTime"/>
  </xs:complexType>

  <xs:complexType name="BansType">
    <xs:sequence>
      <xs:element name="ban" type="gs:BanType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================= ELEMENTO RADICE ======================= -->

  <xs:element name="gameServer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="motd"     type="xs:string"      minOccurs="0"/>
        <xs:element name="network"  type="gs:NetworkType"/>
        <xs:element name="gameMode" type="gs:GameModeType"/>
        <xs:element name="plugins"  type="gs:PluginsType" minOccurs="0"/>
        <xs:element name="players"  type="gs:PlayersType"/>
        <xs:element name="bans"     type="gs:BansType"    minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name"    type="xs:string"      use="required"/>
      <xs:attribute name="version" type="gs:VersionType"/>
      <xs:attribute name="region"  type="gs:RegionType"  default="EU"/>
    </xs:complexType>

    <!-- ================= VALIDAZIONE AVANZATA ================= -->

    <!-- Chiave primaria: ogni player ha un id univoco e obbligatorio -->
    <xs:key name="playerKey">
      <xs:selector xpath="gs:players/gs:player"/>
      <xs:field xpath="@id"/>
    </xs:key>

    <!-- I nickname non possono ripetersi -->
    <xs:unique name="nicknameUnique">
      <xs:selector xpath="gs:players/gs:player"/>
      <xs:field xpath="gs:nickname"/>
    </xs:unique>

    <!-- Chiavi esterne: ban/@player e ban/@by devono puntare a un player esistente -->
    <xs:keyref name="banPlayerRef" refer="gs:playerKey">
      <xs:selector xpath="gs:bans/gs:ban"/>
      <xs:field xpath="@player"/>
    </xs:keyref>
    <xs:keyref name="banByRef" refer="gs:playerKey">
      <xs:selector xpath="gs:bans/gs:ban"/>
      <xs:field xpath="@by"/>
    </xs:keyref>
  </xs:element>

</xs:schema>
