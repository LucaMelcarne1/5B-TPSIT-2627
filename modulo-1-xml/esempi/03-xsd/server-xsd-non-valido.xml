<?xml version="1.0" encoding="UTF-8"?>
<!-- Well-formed, ma NON valido: contiene errori di TIPO che il DTD non avrebbe mai individuato.
     ERRORE 0: version="2.4" sulla radice non rispetta il pattern X.Y.Z (servono tre numeri).
     Gli ERRORI 1-10 sono numerati nei commenti qui sotto.
     Eseguilo con ../../validatori/valida.sh xsd game-server.xsd server-xsd-non-valido.xml -->
<gameServer xmlns="https://tpsit.example.org/gameserver"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://tpsit.example.org/gameserver game-server.xsd"
            name="ArenaCraft EU-1" version="2.4" region="EU">

  <network>
    <!-- ERRORE 1: 300 non è un ottetto IPv4 valido (pattern) -->
    <ip>300.168.1.10</ip>
    <!-- ERRORE 2: la porta 80 è sotto il minimo 1024 (minInclusive) -->
    <port>80</port>
    <!-- ERRORE 3: 1000 supera il massimo 500 (maxInclusive) -->
    <maxPlayers>1000</maxPlayers>
  </network>

  <!-- ERRORE 4: "hardcore" non è nell'enumerazione -->
  <gameMode>hardcore</gameMode>

  <players>
    <player id="P001" role="admin">
      <!-- ERRORE 5: lo spazio e il "!" non sono ammessi nel nickname (pattern) -->
      <nickname>Dragon Slayer!</nickname>
      <!-- ERRORE 6: il livello massimo è 100 -->
      <level>150</level>
      <!-- ERRORE 7: xs:date vuole AAAA-MM-GG, non GG/MM/AAAA -->
      <joined>17/10/2026</joined>
    </player>
    <player id="P002">
      <!-- ERRORE 8: nickname duplicato (xs:unique) -->
      <nickname>Dragon_Slayer</nickname>
      <level>10</level>
    </player>
    <player id="P003">
      <nickname>Dragon_Slayer</nickname>
      <level>10</level>
    </player>
  </players>

  <bans>
    <!-- ERRORE 9: P999 non esiste (xs:keyref); ERRORE 10: manca l'elemento <reason> -->
    <ban player="P999" by="P001"/>
  </bans>

</gameServer>
